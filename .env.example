# Backend settings (read by backend/src/shared/config.py from ./.env or ../.env).
# Copy to `.env` and adjust. All values shown are defaults.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./travel_planner.db

# Auth — set a random value of 32+ characters outside local dev (ENVIRONMENT=production
# refuses to start with the default).
JWT_SECRET=change-me-in-dev-only-not-a-real-secret
JWT_EXPIRE_MINUTES=1440

# LLM: "anthropic" (Claude API; needs a key from https://console.anthropic.com),
# "ollama" (a local model at OLLAMA_URL), or "fake" (deterministic, for tests/E2E).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Any Claude model id, e.g. claude-sonnet-5-5, claude-opus-5-5, claude-haiku-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Per-reply token cap; adaptive thinking counts against it.
ANTHROPIC_MAX_TOKENS=16000
# Re-run requests that Claude's safety filters decline on a fallback model (server-side).
ANTHROPIC_REFUSAL_FALLBACK=true
# Used when LLM_PROVIDER=ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Flight search: "serpapi" (Google Flights results; needs a key from https://serpapi.com,
# free for 250 searches a month; without one the flights stage says flight search is
# unavailable) or "fake" (made-up flights, no network).
FLIGHT_PROVIDER=serpapi
SERPAPI_API_KEY=
FLIGHT_SEARCH_TIMEOUT_SECONDS=30
# Hotel search for the planner's lodging stage: "serpapi" (Google Hotels, the same key) or
# "fake" (made-up places to stay, no network).
HOTEL_PROVIDER=serpapi
HOTEL_SEARCH_TIMEOUT_SECONDS=30
# Place search for the planner's activities stage: "serpapi" (Google Maps, the same key)
# or "fake" (made-up museums and restaurants, no network).
PLACES_PROVIDER=serpapi
PLACES_SEARCH_TIMEOUT_SECONDS=30

# HTTP. CORS_ORIGINS is a JSON list of allowed browser origins (no "*" in production).
CORS_ORIGINS=["http://localhost:5173"]
MAX_REQUEST_BYTES=65536
# Per-minute limits; 0 disables. Planning turns (free text, continue) are per user, auth
# (login + register) per client IP.
CHAT_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10