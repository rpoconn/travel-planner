# Backend settings (read by backend/src/shared/config.py from ./.env or ../.env).
# Copy to `.env` and adjust. All values shown are defaults.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./travel_planner.db

# Auth — set a random value of 32+ characters outside local dev (ENVIRONMENT=production
# refuses to start with the default).
JWT_SECRET=change-me-in-dev-only-not-a-real-secret
JWT_EXPIRE_MINUTES=1440

# Local LLM: "ollama" for real model, "fake" for deterministic tests/E2E.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Web search: "tavily" (needs a key from https://tavily.com; without one the agent is told
# search is unavailable) or "fake" (placeholder results, no network). Results are cached in
# the DB for SEARCH_CACHE_TTL_HOURS.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=15
SEARCH_CACHE_TTL_HOURS=24

# HTTP. CORS_ORIGINS is a JSON list of allowed browser origins (no "*" in production).
CORS_ORIGINS=["http://localhost:5173"]
MAX_REQUEST_BYTES=65536
# Per-minute limits; 0 disables. Chat is per user, auth (login + register) per client IP.
CHAT_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10
