# Backend settings (read by backend/src/shared/config.py from ./.env or ../.env).
# Copy to `.env` and adjust. All values shown are defaults.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./travel_planner.db

# Auth — set a long random value outside local dev.
JWT_SECRET=change-me-in-dev-only
JWT_EXPIRE_MINUTES=1440

# Local LLM: "ollama" for real model, "fake" for deterministic tests/E2E.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Web search (Phase 4). Get a key at https://tavily.com
TAVILY_API_KEY=

# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173"]
